# =====================================================
# Passei Concurso — Variáveis para a Vercel
# =====================================================
# Copie os NOMES abaixo para o painel da Vercel.
# NÃO use este arquivo como .env real.
# =====================================================

# ======= OBRIGATÓRIAS PARA O PRIMEIRO DEPLOY =========

# Banco PostgreSQL na nuvem (Neon, Supabase, Vercel Postgres)
DATABASE_URL=

# Secret para NextAuth (gere com: openssl rand -base64 32)
AUTH_SECRET=

# URL pública onde o site ficará hospedado
AUTH_URL=
NEXTAUTH_URL=

# Informações públicas do site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=Passei Concurso

# ======= OBRIGATÓRIAS PARA PRODUÇÃO ==================

# Secret para proteger endpoints de cron
CRON_SECRET=

# Credenciais do admin inicial (usadas apenas no seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ======= OPCIONAIS ===================================

# (nenhuma — todas as integrações são configuradas pelo painel admin)

# ======= INTEGRAÇÕES FUTURAS =========================

# Caso implemente envio de emails:
# RESEND_API_KEY=
# EMAIL_FROM=
