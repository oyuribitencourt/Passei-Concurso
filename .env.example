# ===========================================
# Passei Concurso — Variáveis de Ambiente
# ===========================================

# ---- Banco de dados (obrigatório) ----
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# ---- Autenticação NextAuth (obrigatório) ----
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_URL="https://seudominio.com.br"
NEXTAUTH_URL="https://seudominio.com.br"

# ---- Admin inicial — usado pelo seed (obrigatório no seed) ----
ADMIN_EMAIL="admin@seudominio.com.br"
ADMIN_PASSWORD="senha-com-no-minimo-12-caracteres"

# ---- Cron jobs (obrigatório) ----
CRON_SECRET="gere-um-secret-aleatorio"

# ---- Site público (obrigatório) ----
NEXT_PUBLIC_SITE_URL="https://seudominio.com.br"
NEXT_PUBLIC_SITE_NAME="Passei Concurso"

# ---- Integrações opcionais ----
# Ticto, Meta Pixel, Google Ads, GA4, Search Console
# são configurados via painel admin, não por variáveis de ambiente.
